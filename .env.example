# Salin file ini menjadi ".env" lalu sesuaikan nilainya.
# File .env TIDAK di-commit ke git (lihat .gitignore).

SECRET_KEY=ganti-dengan-string-acak-panjang
# DATABASE_URL=sqlite:///data/sertifikat.db

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- OTP & Sertifikat dikirim via Email ----
# Nama + NIM + No. WA tetap dipakai untuk mencocokkan identitas peserta ke
# data yang diunggah admin (No. WA tidak lagi dipakai untuk mengirim apa
# pun). Kode OTP dan file sertifikat PDF sama-sama dikirim ke EMAIL peserta.
# true  = email tidak benar-benar terkirim; kode OTP ditampilkan di layar dan
#         file PDF disimpan ke data/generated/.
# false = email benar-benar dikirim, wajib isi SMTP_* di bawah.
EMAIL_DEMO_MODE=true

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@kejati-jateng.go.id

BASE_URL=http://127.0.0.1:5000
