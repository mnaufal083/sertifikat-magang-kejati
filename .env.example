# Salin file ini menjadi ".env" lalu sesuaikan nilainya.
# File .env TIDAK di-commit ke git (lihat .gitignore).

SECRET_KEY=ganti-dengan-string-acak-panjang
# DATABASE_URL=sqlite:///data/sertifikat.db

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- OTP dikirim via WhatsApp ----
# true  = kode OTP ditampilkan langsung di layar, tanpa perlu akun WhatsApp API.
# false = OTP benar-benar dikirim via WhatsApp, wajib isi WA_* di bawah.
WA_DEMO_MODE=true
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=

# ---- Sertifikat dikirim via Email (lampiran PDF) ----
# true  = email tidak benar-benar terkirim; file PDF disimpan ke data/generated/.
# false = email benar-benar dikirim, wajib isi SMTP_* di bawah.
EMAIL_DEMO_MODE=true

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@kejati-jateng.go.id

BASE_URL=http://127.0.0.1:5000
